<UserControl x:Class="FastSearchAddIn.UI.SearchTaskPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="360"
             Background="#FAFAFA"
             FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <!-- ── Colours ───────────────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="AccentBrush"    Color="#0078D4"/>
        <SolidColorBrush x:Key="LightBorder"    Color="#D0D0D0"/>
        <SolidColorBrush x:Key="RowOdd"         Color="#F0F4F9"/>
        <SolidColorBrush x:Key="RowEven"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SelectedRow"    Color="#CCE4F7"/>
        <SolidColorBrush x:Key="StatusNormal"   Color="#444444"/>
        <SolidColorBrush x:Key="StatusError"    Color="#CC0000"/>

        <!-- ── Search TextBox style ──────────────────────────────────────────── -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height"         Value="30"/>
            <Setter Property="Padding"        Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"    Value="{StaticResource LightBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"     Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Button base style ─────────────────────────────────────────────── -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height"           Value="28"/>
            <Setter Property="Padding"          Value="10,2"/>
            <Setter Property="Background"       Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Result item template ──────────────────────────────────────────── -->
        <DataTemplate x:Key="ResultItemTemplate">
            <Border Padding="6,4" BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource LightBorder}">
                <StackPanel>
                    <!-- Subject (bold) -->
                    <TextBlock Text="{Binding Subject}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Subject}"/>
                    <!-- Sender + date on one line -->
                    <DockPanel>
                        <TextBlock Text="{Binding SenderName}"
                                   Foreground="#555"
                                   TextTrimming="CharacterEllipsis"
                                   DockPanel.Dock="Left" MaxWidth="200"/>
                        <TextBlock Text="{Binding ReceivedTime, StringFormat='yyyy-MM-dd HH:mm'}"
                                   Foreground="#888" FontSize="10"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <!-- Sender email (smaller) -->
                    <TextBlock Text="{Binding SenderEmail}"
                               Foreground="#999" FontSize="10"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Search box -->
            <RowDefinition Height="Auto"/>
            <!-- Status / progress -->
            <RowDefinition Height="Auto"/>
            <!-- Results list -->
            <RowDefinition Height="*"/>
            <!-- Export toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Export status -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title ──────────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="⚡ Fast Search"
                       FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>
            <Button x:Name="BtnReindex"
                    Content="Re-index"
                    Style="{StaticResource ActionButton}"
                    Width="70" Height="22" FontSize="10"
                    Margin="8,0,0,0"
                    ToolTip="Re-build the Lucene index from scratch"
                    Click="BtnReindex_Click"/>
        </StackPanel>

        <!-- ── Search TextBox ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSearch"
                     Grid.Column="0"
                     Style="{StaticResource SearchBoxStyle}"
                     Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="TxtSearch_TextChanged"
                     KeyDown="TxtSearch_KeyDown">
                <!-- Placeholder -->
                <TextBox.Resources>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="Search email…"
                                                           Foreground="#AAAAAA"
                                                           Margin="7,4,0,0"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <Button x:Name="BtnClear"
                    Grid.Column="1"
                    Content="✕"
                    Width="28" Height="30"
                    Margin="4,0,0,0"
                    ToolTip="Clear search"
                    Background="Transparent"
                    BorderBrush="{StaticResource LightBorder}"
                    Foreground="#555"
                    Click="BtnClear_Click"/>
        </Grid>

        <!-- ── Index / search status row ──────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus"
                       Grid.Column="0"
                       Text="Ready."
                       Foreground="{StaticResource StatusNormal}"
                       FontSize="10"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TxtResultCount"
                       Grid.Column="1"
                       Text=""
                       Foreground="{StaticResource StatusNormal}"
                       FontSize="10"/>
            <!-- Indeterminate spinner shown during indexing -->
            <ProgressBar x:Name="PbarIndexing"
                         Grid.Column="0" Grid.ColumnSpan="2"
                         Height="2" VerticalAlignment="Bottom"
                         IsIndeterminate="True"
                         Visibility="Collapsed"
                         Foreground="{StaticResource AccentBrush}"
                         Background="Transparent" BorderThickness="0"/>
        </Grid>

        <!-- ── Results ListView ──────────────────────────────────────────────── -->
        <ListView x:Name="LstResults"
                  Grid.Row="3"
                  ItemsSource="{Binding Results}"
                  ItemTemplate="{StaticResource ResultItemTemplate}"
                  SelectionMode="Extended"
                  BorderBrush="{StaticResource LightBorder}"
                  BorderThickness="1"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource SelectedRow}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E5F1FB"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- ── Export toolbar ────────────────────────────────────────────────── -->
        <Border Grid.Row="4"
                Background="#F0F0F0"
                BorderBrush="{StaticResource LightBorder}"
                BorderThickness="0,1,0,0"
                Padding="0,6,0,4"
                Margin="0,6,0,0">
            <DockPanel>
                <TextBlock Text="Export selected:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           FontWeight="SemiBold"/>

                <!-- Sort by Sender -->
                <Button x:Name="BtnExportSender"
                        Content="By Sender"
                        Style="{StaticResource ActionButton}"
                        Margin="0,0,4,0"
                        ToolTip="Export to Desktop\Outlook_Exports\&lt;sender email&gt;"
                        Click="BtnExportSender_Click"/>

                <!-- Sort by Date -->
                <Button x:Name="BtnExportDate"
                        Content="By Date"
                        Style="{StaticResource ActionButton}"
                        Margin="0,0,4,0"
                        ToolTip="Export to Desktop\Outlook_Exports\&lt;year\month&gt;"
                        Click="BtnExportDate_Click"/>

                <!-- Sort by Domain -->
                <Button x:Name="BtnExportDomain"
                        Content="By Domain"
                        Style="{StaticResource ActionButton}"
                        ToolTip="Export to Desktop\Outlook_Exports\&lt;domain&gt;"
                        Click="BtnExportDomain_Click"/>
            </DockPanel>
        </Border>

        <!-- ── Export status / progress ──────────────────────────────────────── -->
        <Grid Grid.Row="5" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar x:Name="PbarExport"
                         Grid.Row="0"
                         Height="6"
                         Minimum="0" Maximum="100"
                         Value="0"
                         Visibility="Collapsed"
                         Foreground="{StaticResource AccentBrush}"
                         BorderThickness="0"/>
            <TextBlock x:Name="TxtExportStatus"
                       Grid.Row="1"
                       Text=""
                       FontSize="10"
                       Foreground="{StaticResource StatusNormal}"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"/>
        </Grid>
    </Grid>
</UserControl>
